    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">

    <group
        android:scaleX="2.6"
        android:scaleY="2.6"
        android:translateX="-20.4"
        android:translateY="-20.4">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,24 L82,44 L82,62 L62,62 L62,84 L46,84 L46,62 L26,62 L26,44 Z" />
    </group>
</vector>
