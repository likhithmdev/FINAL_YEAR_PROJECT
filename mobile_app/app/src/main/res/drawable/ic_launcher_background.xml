<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon backdrop. A single diagonal gradient keeps the mark legible at
  48dp while giving the icon depth on both light and dark launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="8"
                android:startY="0"
                android:endX="100"
                android:endY="108">
                <item android:offset="0" android:color="#FFF2354C" />
                <item android:offset="0.55" android:color="#FFE01F38" />
                <item android:offset="1" android:color="#FF9E0D1E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
